    "左滑可以删除班次，删除后循环里用到它的日子也会去掉。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左滑可以删除班次，删除后循环里用到它的日子也会去掉。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe left to delete a shift type. Its days will also be removed from the cycle."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向左滑動可刪除班次，循環中使用該班次的日子也會一併移除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左にスワイプすると勤務の種類を削除できます。周期内のその日も削除されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische nach links, um eine Schichtart zu löschen. Ihre Tage werden auch aus dem Zyklus entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la izquierda para eliminar un tipo de turno. Sus días también se quitan del ciclo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para a esquerda para apagar um tipo de turno. Os dias dele também saem do ciclo."
          }
        }
      }
    },
    "已导入「%@」排班，和同事的班次完全对齐。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导入「%@」排班，和同事的班次完全对齐。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported “%@”. Your rotation is now aligned with your team's."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已匯入「%@」班表，與同事的輪班循環同步。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を取り込みました。チームと同じローテーションになりました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ importiert. Dein Rhythmus ist jetzt an dein Team angepasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» importado. Tu ritmo ya coincide con el de tu equipo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” importado. Sua escala agora é igual à da equipe."
          }
        }
      }
    },
