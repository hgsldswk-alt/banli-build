    "比如两班倒今天是第二个夜班，就选对应的那一天。选好后整个日历会自动排好。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比如两班倒今天是第二个夜班，就选对应的那一天。选好后整个日历会自动排好。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the day that matches your current shift in the cycle. The calendar will fill in automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇循環中與今天班次相符的那一天，行事曆就會自動排好。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまの周期で今日にあたる日を選ぶと、カレンダーが自動で埋まります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Tag, der zu deiner aktuellen Schicht im Zyklus passt. Der Kalender füllt sich automatisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el día que corresponde a tu turno actual en el ciclo. El calendario se rellena solo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o dia que corresponde ao seu turno atual no ciclo. O calendário se preenche sozinho."
          }
        }
      }
    },
    "比如：白班、A班、大夜": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比如：白班、A班、大夜"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example Day, Team A, or Night"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例如日班、A班、大夜"
          }
        },
        "ja": {
