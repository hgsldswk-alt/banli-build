    "按循环这天应该是「%@」。只改这一天，不影响后面的循环。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按循环这天应该是「%@」。只改这一天，不影响后面的循环。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rotation has “%@” for this day. Changes here apply to this day only."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依循環，這天應為「%@」。調整只套用於當天，後續循環照常。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日はローテーションでは「%@」です。ここでの変更はこの日だけに反映されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laut Rhythmus ist an diesem Tag „%@“. Änderungen hier gelten nur für diesen Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según el ritmo, este día es «%@». Los cambios aquí solo afectan a este día."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pela escala, este dia é “%@”. Alterações aqui valem só para este dia."
          }
        }
      }
    },
    "按时吃饭，照顾好自己": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按时吃饭，照顾好自己"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eat regularly and take care of yourself."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記得按時吃飯，好好照顧自己"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事をきちんととって、体を大事にしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Iss regelmäßig und pass auf dich auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Come a tus horas y cuídate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coma nos horários e cuide-se."
          }
        }
      }
    },
    "按班次时间自动提醒，倒班不再记错点": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
