    "2. 点左上角「编辑」→「添加小组件」": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 点左上角「编辑」→「添加小组件」"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Tap Edit at the top left, then Add Widget."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 點左上角「編輯」→「加入小工具」"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 左上の「編集」→「ウィジェットを追加」をタップします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Tippe oben links auf Bearbeiten und dann auf Widget hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Toca Editar arriba a la izquierda y luego Añadir widget."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Toque em Editar no canto superior esquerdo e depois em Adicionar Widget."
          }
        }
      }
    },
    "2. 点时间下方的小组件区域": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 点时间下方的小组件区域"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Tap the widget area below the time."
