    "定位权限没打开，天气用不了。可以到 iPhone 的「设置 > 班历 > 位置」里改成「使用 App 期间」。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位权限没打开，天气用不了。可以到 iPhone 的「设置 > 班历 > 位置」里改成「使用 App 期间」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable location access for weather in iPhone Settings > ShiftCal > Location > While Using the App."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "天氣功能需要定位權限。請到 iPhone「設定 > 班曆 > 位置」選擇「使用 App 期間」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気を表示するには、iPhoneの「設定」>「ShiftCal」>「位置情報」>「このAppの使用中のみ許可」をオンにしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Standort für das Wetter unter iPhone-Einstellungen > ShiftCal > Standort > Beim Verwenden der App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite la ubicación para el tiempo en Ajustes del iPhone > ShiftCal > Ubicación > Cuando se use la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita a localização para o tempo em Ajustes do iPhone > ShiftCal > Localização > Durante o Uso do App."
          }
        }
      }
    },
