    "换成「%@」会替换现在的班次和循环，单日调班也会清空。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换成「%@」会替换现在的班次和循环，单日调班也会清空。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to “%@”? This replaces your shift types and cycle and clears individual changes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改用「%@」將取代目前的班次及循環，並清除單日調班。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に切り替えますか？勤務の種類と周期が置き換わり、個別の変更は消去されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu „%@“ wechseln? Das ersetzt Schichtarten und Zyklus und löscht eigene Änderungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cambiar a «%@»? Se reemplazan los tipos de turno y el ciclo, y se borran los cambios propios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudar para “%@”? Isso substitui tipos de turno e ciclo e apaga suas alterações."
          }
        }
      }
    },
