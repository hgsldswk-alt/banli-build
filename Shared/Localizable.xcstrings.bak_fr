    "这个时间晚于上班时间，不会响。请提前，或改成「前一天」。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个时间晚于上班时间，不会响。请提前，或改成「前一天」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is after your shift starts, so it won't ring. Pick an earlier time or Day before."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個時間晚於上班時間，不會響。請提前，或改成「前一天」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勤務開始より後のため鳴りません。もっと早い時刻か「前日」を選んでください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das liegt nach deinem Schichtbeginn und klingelt nicht. Wähle eine frühere Zeit oder Vortag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es después de empezar tu turno y no sonará. Elige una hora anterior o Día anterior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso é depois do início do seu turno e não vai tocar. Escolha um horário antes ou Dia anterior."
          }
        }
      }
    },
    "按班次设闹钟": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
