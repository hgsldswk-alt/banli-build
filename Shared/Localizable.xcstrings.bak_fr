          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por exemplo Dia, Equipe A ou Noite"
          }
        }
      }
    },
    "没认出排班口令。请让同事在「班历 > 设置 > 把排班发给同事」里发给你，复制整段话再点粘贴。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没认出排班口令。请让同事在「班历 > 设置 > 把排班发给同事」里发给你，复制整段话再点粘贴。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code not recognized. Ask your coworker to share it from ShiftCal > Settings > Share rotation with team. Copy the full message and tap Paste."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法辨識排班口令。請同事從「班曆 > 設定 > 將班表傳給同事」傳送，複製整段訊息後再點「貼上」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードを認識できませんでした。同僚に「ShiftCal」>「設定」>「ローテーションをチームと共有」から送ってもらい、メッセージ全体をコピーして「貼り付け」をタップしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code nicht erkannt. Bitte deinen Kollegen, ihn über ShiftCal > Einstellungen > Rhythmus mit dem Team teilen zu senden. Kopiere die ganze Nachricht und tippe auf Einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código no reconocido. Pide a tu compañero que lo envíe desde ShiftCal > Ajustes > Compartir ritmo con el equipo. Copia todo el mensaje y toca Pegar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Código não reconhecido. Peça ao colega para enviar em ShiftCal > Ajustes > Compartilhar escala com a equipe. Copie a mensagem inteira e toque em Colar."
          }
        }
      }
    },
