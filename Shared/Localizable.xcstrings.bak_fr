    "按班次开始日的前一天提醒，夜班和跨夜班也一样。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按班次开始日的前一天提醒，夜班和跨夜班也一样。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders are sent the day before the shift starts, including overnight shifts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依班次開始日的前一天提醒，夜班和跨夜班也一樣。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は勤務開始の前日に届きます（夜勤も含む）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen kommen am Tag vor Schichtbeginn, auch bei Nachtschichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos llegan el día antes de empezar el turno, también en turnos de noche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes chegam no dia anterior ao início do turno, inclusive nos noturnos."
          }
        }
      }
    },
