          "stringUnit": {
            "state": "translated",
            "value": "当天或前一天，均以这个班的开始日期为准。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same day and previous day refer to the date this shift starts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當天或前一天，均以這個班的開始日期為準。"
