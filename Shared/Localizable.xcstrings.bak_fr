    "小组件是高级版功能。没解锁时，小组件上会提示解锁。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小组件是高级版功能。没解锁时，小组件上会提示解锁。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets are a Pro feature. Unlock Pro to show your shifts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小工具為進階版功能，解鎖後即可顯示班次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットはPro機能です。Proを解放するとシフトが表示されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets sind eine Pro-Funktion. Schalte Pro frei, um deine Schichten zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los widgets son una función Pro. Desbloquea Pro para ver tus turnos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets são um recurso Pro. Desbloqueie o Pro para ver seus turnos."
          }
        }
      }
    },
    "小雨": {
      "extractionState": "manual",
      "localizations": {
