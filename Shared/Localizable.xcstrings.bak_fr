        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「当日」「前日」は、この勤務が始まる日を基準にしています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleicher Tag und Vortag beziehen sich auf den Tag, an dem die Schicht beginnt."
          }
        },
        "es": {
