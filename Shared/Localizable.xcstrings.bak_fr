    "把 iPhone 升级到 iOS 26 后，可以改用静音也会响的闹钟。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 iPhone 升级到 iOS 26 后，可以改用静音也会响的闹钟。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update your iPhone to iOS 26 to use alarms that ring even on silent."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 iPhone 升級到 iOS 26 後，可改用靜音也會響的鬧鐘。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マナーモードでも鳴るアラームを使うには、iOS 26にアップデートしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere dein iPhone auf iOS 26, um Wecker zu nutzen, die auch im Stummmodus klingeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza tu iPhone a iOS 26 para usar alarmas que suenan aunque esté en silencio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o iPhone para iOS 26 para usar alarmes que tocam mesmo no silencioso."
          }
        }
      }
    },
