    "下班时间早于上班时间表示跨夜，比如 20:00 上班、第二天 08:00 下班。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下班时间早于上班时间表示跨夜，比如 20:00 上班、第二天 08:00 下班。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An end time earlier than the start time means an overnight shift, such as 20:00–08:00 the next day."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下班時間早於上班時間表示跨夜，例如 20:00 上班、隔天 08:00 下班。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了時刻が開始時刻より早い場合は夜勤として扱います（例：20:00〜翌08:00）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liegt die Endzeit vor der Startzeit, ist es eine Nachtschicht, z. B. 20:00–08:00 am Folgetag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la hora de fin es anterior a la de inicio, es un turno de noche, p. ej. 20:00–08:00 del día siguiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o fim for antes do início, é um turno noturno, ex.: 20:00–08:00 do dia seguinte."
          }
        }
      }
    },
    "不用打开 App，就能看到今天和接下来几天上什么班。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不用打开 App，就能看到今天和接下来几天上什么班。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See today's shift and the days ahead at a glance."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接查看今天及接下來幾天的班次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日と先のシフトがひと目でわかります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heutige Schicht und die nächsten Tage auf einen Blick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El turno de hoy y los próximos días de un vistazo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O turno de hoje e dos próximos dias num relance."
          }
        }
      }
    },
