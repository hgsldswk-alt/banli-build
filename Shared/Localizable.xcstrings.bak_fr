    "旧闹钟未能全部清除，新的排班尚未生效。请重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧闹钟未能全部清除，新的排班尚未生效。请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old alarms could not all be cleared. The new schedule has not taken effect. Please try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊鬧鐘未能全部清除，新的班表尚未生效。請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いアラームをすべて消去できなかったため、新しいシフトは反映されていません。もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte Wecker konnten nicht alle gelöscht werden. Der neue Plan ist noch nicht aktiv. Bitte versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron borrar todas las alarmas antiguas. El nuevo plan aún no está activo. Inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível apagar todos os alarmes antigos. A nova escala ainda não está ativa. Tente de novo."
          }
        }
      }
    },
    "部分闹钟未能排入系统，成功排入的闹钟会保留。请减少闹钟数量后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分闹钟未能排入系统，成功排入的闹钟会保留。请减少闹钟数量后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some alarms could not be scheduled. Successfully scheduled alarms are kept. Reduce the number of alarms and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分鬧鐘未能排入系統，成功排入的鬧鐘會保留。請減少鬧鐘數量後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のアラームを設定できませんでした。設定できたアラームは残してあります。アラームの数を減らしてもう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Wecker konnten nicht geplant werden. Erfolgreich geplante bleiben erhalten. Reduziere die Anzahl und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron programar algunas alarmas. Las programadas se mantienen. Reduce el número e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns alarmes não puderam ser agendados. Os agendados foram mantidos. Reduza a quantidade e tente de novo."
          }
        }
      }
    },
