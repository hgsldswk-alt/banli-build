        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックをタップして今日にあたる日を指定すると、カレンダー全体がそれに合わせて埋まります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Block, um den heutigen Tag zu markieren. Der ganze Kalender richtet sich danach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un bloque para marcar el día de hoy. Todo el calendario se ajusta a él."
          }
