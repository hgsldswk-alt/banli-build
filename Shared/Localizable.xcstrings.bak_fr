    "当天的时间不能晚于上班时间；如果需要提前一晚，选择「前一天」。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当天的时间不能晚于上班时间；如果需要提前一晚，选择「前一天」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same-day alarms must be at or before the shift starts. For the night before, choose Previous day."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當天的時間不能晚於上班時間；如需提前一晚，選擇「前一天」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "当日のアラームは勤務開始時刻以前に設定してください。前の晩に鳴らすには「前日」を選びます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker am gleichen Tag müssen vor oder bei Schichtbeginn liegen. Für den Vorabend wähle Vortag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alarmas del mismo día deben ser antes o al empezar el turno. Para la noche anterior, elige Día anterior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmes do mesmo dia devem ser antes ou no início do turno. Para a noite anterior, escolha Dia anterior."
          }
        }
      }
    },
    "休息日不能设置闹钟，或这个班次已删除。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "休息日不能设置闹钟，或这个班次已删除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shift is a day off or has been deleted. No alarms can be set."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "休息日不能設定鬧鐘，或這個班次已刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この勤務は休日か削除済みのため、アラームを設定できません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
