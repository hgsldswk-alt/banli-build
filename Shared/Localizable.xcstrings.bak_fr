    "清除后，所有单日调班都恢复成循环排班。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除后，所有单日调班都恢复成循环排班。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear all individual changes and reset those days to the rotation?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除後，所有單日調班將回復為循環班表。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個別の変更をすべて消去して、その日をローテーションどおりに戻しますか？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle eigenen Änderungen löschen und diese Tage auf den Rhythmus zurücksetzen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar todos los cambios propios y volver estos días al ritmo?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar todas as alterações e voltar estes dias à escala?"
          }
        }
      }
    },
