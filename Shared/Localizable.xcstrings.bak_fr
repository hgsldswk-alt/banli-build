    "按班次设置闹钟": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按班次设置闹钟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms by shift"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依班次設定鬧鐘"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勤務ごとのアラーム"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker pro Schicht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmas por turno"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmes por turno"
          }
        }
      }
    },
    "每个班可以设多个闹钟，比如早班 6:00、6:10。调班后自动按新班次响，休息日不响。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个班可以设多个闹钟，比如早班 6:00、6:10。调班后自动按新班次响，休息日不响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set several alarms per shift, like 6:00 and 6:10 for the early shift. Alarms follow any day you swap, and stay quiet on days off."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個班可設多個鬧鐘，例如早班 6:00、6:10。調班後自動依新班次響，休息日不響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早番は6:00と6:10のように、勤務ごとに複数のアラームを設定できます。シフト交代にも自動で追従し、休みの日は鳴りません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell mehrere Wecker pro Schicht, z. B. 6:00 und 6:10 für die Frühschicht. Wecker folgen getauschten Tagen und bleiben an freien Tagen still."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon varias alarmas por turno, como 6:00 y 6:10 para el de mañana. Las alarmas siguen los cambios de turno y no suenan en días libres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina vários alarmes por turno, como 6:00 e 6:10 para o da manhã. Os alarmes seguem as trocas de turno e ficam em silêncio nas folgas."
          }
        }
      }
    },
    "锁屏实时显示": {
      "extractionState": "manual",
      "localizations": {
