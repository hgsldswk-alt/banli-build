    "1. 在桌面空白处长按，直到图标开始晃动": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 在桌面空白处长按，直到图标开始晃动"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Touch and hold an empty area of your Home Screen until the icons jiggle."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 長按主畫面空白處，直到圖示開始晃動"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. ホーム画面の何もない所を、アイコンが揺れるまで長押しします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Halte eine leere Stelle auf dem Home-Bildschirm gedrückt, bis die Symbole wackeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Mantén pulsado un espacio vacío de la pantalla de inicio hasta que los iconos se muevan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Toque e segure uma área vazia da Tela de Início até os ícones tremerem."
          }
        }
      }
    },
    "1. 在锁屏长按，点「自定」→「锁定屏幕」": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 在锁屏长按，点「自定」→「锁定屏幕」"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Touch and hold the Lock Screen, then tap Customize → Lock Screen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 長按鎖定畫面，點「自訂」→「鎖定畫面」"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. ロック画面を長押しし、「カスタマイズ」→「ロック画面」をタップします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Halte den Sperrbildschirm gedrückt und tippe auf Anpassen → Sperrbildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Mantén pulsada la pantalla bloqueada y toca Personalizar → Pantalla bloqueada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Toque e segure a Tela Bloqueada e toque em Personalizar → Tela Bloqueada."
          }
        }
      }
    },
