    "早班、夜班各设各的闹钟，调班后自动跟着变，休息日不吵你": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "早班、夜班各设各的闹钟，调班后自动跟着变，休息日不吵你"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate alarms for early and night shifts. They follow your swaps and stay quiet on days off."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "早班、夜班各設各的鬧鐘，調班後自動跟著變，休息日不吵你"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早番と夜勤で別々のアラーム。シフト交代に追従し、休みの日は鳴りません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Wecker für Früh- und Nachtschicht. Sie folgen deinen Tauschen und bleiben an freien Tagen still."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmas propias para turnos de mañana y de noche. Siguen tus cambios de turno y no suenan en días libres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmes próprios para turnos da manhã e da noite. Seguem suas trocas e ficam em silêncio nas folgas."
          }
        }
      }
    },
    "睡前告诉你明天上什么班、几点上，不用再翻排班表": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前告诉你明天上什么班、几点上，不用再翻排班表"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know tomorrow's shift and start time before bed. No more checking the roster."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前告訴你明天上什麼班、幾點上，不用再翻班表"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "寝る前に明日の勤務と開始時刻がわかります。もうシフト表を確認しに行く必要はありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenne die Schicht und Startzeit von morgen schon vor dem Schlafen. Kein Blick mehr auf den Dienstplan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conoce el turno y la hora de mañana antes de dormir. Sin mirar el cuadrante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiba o turno e o horário de amanhã antes de dormir. Sem conferir a escala."
          }
        }
      }
    },
