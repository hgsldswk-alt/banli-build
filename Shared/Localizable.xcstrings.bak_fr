        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天休息，外面可能下雨，在家歇着吧"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off today. Rain is possible, so enjoy some time at home."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天休息，外面可能下雨，在家放鬆一下吧"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は休み。雨の可能性があるので、家でゆっくりどうぞ。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute frei. Es könnte regnen – genieß die Zeit zu Hause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy libras. Puede llover: disfruta en casa."
