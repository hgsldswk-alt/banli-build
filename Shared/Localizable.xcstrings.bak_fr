            "state": "translated",
            "value": "Live Activities are disabled. Enable them in Settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時動態已關閉，請在系統設定中開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブアクティビティがオフです。「設定」でオンにしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivitäten sind deaktiviert. Aktiviere sie in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las Actividades en Vivo están desactivadas. Actívalas en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As Atividades ao Vivo estão desativadas. Ative em Ajustes."
