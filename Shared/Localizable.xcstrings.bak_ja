    "按班次设置闹钟": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按班次设置闹钟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms by shift"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依班次設定鬧鐘"
          }
        }
      }
    },
    "每个班可以设多个闹钟，比如早班 6:00、6:10。调班后自动按新班次响，休息日不响。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个班可以设多个闹钟，比如早班 6:00、6:10。调班后自动按新班次响，休息日不响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set several alarms per shift, like 6:00 and 6:10 for the early shift. Alarms follow any day you swap, and stay quiet on days off."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個班可設多個鬧鐘，例如早班 6:00、6:10。調班後自動依新班次響，休息日不響。"
          }
        }
      }
    },
    "锁屏实时显示": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏实时显示"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live shift on Lock Screen"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定畫面即時顯示"
          }
        }
      }
    },
    "实时活动已关闭，请在系统设置中打开。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
