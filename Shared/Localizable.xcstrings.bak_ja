    "按顺序排：上什么班、连上几天": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按顺序排：上什么班、连上几天"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In order: which shift, how many days in a row"
          }
