            "state": "translated",
            "value": "即時動態已關閉，請在系統設定中開啟。"
          }
        }
      }
    },
    "去设置打开": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去设置打开"
          }
