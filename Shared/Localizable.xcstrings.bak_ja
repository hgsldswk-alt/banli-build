    "%@时只有 %lld°C，多穿一件": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@时只有 %lld°C，多穿一件"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only %2$lld°C when you %1$@. Bring an extra layer."
