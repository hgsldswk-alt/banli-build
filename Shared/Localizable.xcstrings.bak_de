    "换成「%@」会清空现在的单日调班；备注和提醒设置会保留。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换成「%@」会清空现在的单日调班；备注和提醒设置会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching to “%@” clears your one-day changes. Notes and reminder settings are kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "換成「%@」會清除目前的單日調班；備註和提醒設定會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に切り替えると、1日だけの変更は消去されます。メモと通知設定は残ります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsel zu „%@“ löscht deine Eintagesänderungen. Notizen und Erinnerungseinstellungen bleiben."
          }
        }
      }
    },
