        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eat regularly and take care of yourself."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記得按時吃飯，好好照顧自己"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事をきちんととって、体を大事にしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Iss regelmäßig und pass auf dich auf."
          }
        }
      }
    },
    "按班次时间自动提醒，倒班不再记错点": {
