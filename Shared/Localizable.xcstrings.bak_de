    "这个时间晚于上班时间，不会排程。请提前时间或选择前一天。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个时间晚于上班时间，不会排程。请提前时间或选择前一天。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is after the shift starts and will not be scheduled. Choose an earlier time or Previous day."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個時間晚於上班時間，不會排程。請提前時間或選擇前一天。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勤務開始より後の時刻のため設定されません。もっと早い時刻か「前日」を選んでください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das liegt nach Schichtbeginn und wird nicht geplant. Wähle eine frühere Zeit oder Vortag."
          }
        }
      }
    },
    "通知权限已关闭，普通提醒无法送达。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知权限已关闭，普通提醒无法送达。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are disabled. Notification reminders cannot be delivered."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知權限已關閉，一般提醒無法送達。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフのため、リマインダーを届けられません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind deaktiviert. Erinnerungen können nicht zugestellt werden."
          }
        }
      }
    },
    "闹钟权限已关闭，班次闹钟不会响铃。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟权限已关闭，班次闹钟不会响铃。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm access is disabled. Shift alarms will not ring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鬧鐘權限已關閉，班次鬧鐘不會響鈴。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームへのアクセスがオフのため、シフトアラームは鳴りません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weckerzugriff ist deaktiviert. Schichtwecker werden nicht klingeln."
          }
        }
      }
    },
    "重试": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
