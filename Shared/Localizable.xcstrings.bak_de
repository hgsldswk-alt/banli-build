    "按班次设置闹钟": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按班次设置闹钟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms by shift"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依班次設定鬧鐘"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勤務ごとのアラーム"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker pro Schicht"
          }
        }
      }
    },
    "每个班可以设多个闹钟，比如早班 6:00、6:10。调班后自动按新班次响，休息日不响。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个班可以设多个闹钟，比如早班 6:00、6:10。调班后自动按新班次响，休息日不响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set several alarms per shift, like 6:00 and 6:10 for the early shift. Alarms follow any day you swap, and stay quiet on days off."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個班可設多個鬧鐘，例如早班 6:00、6:10。調班後自動依新班次響，休息日不響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早番は6:00と6:10のように、勤務ごとに複数のアラームを設定できます。シフト交代にも自動で追従し、休みの日は鳴りません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell mehrere Wecker pro Schicht, z. B. 6:00 und 6:10 für die Frühschicht. Wecker folgen getauschten Tagen und bleiben an freien Tagen still."
          }
        }
      }
    },
    "锁屏实时显示": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏实时显示"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live shift on Lock Screen"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定畫面即時顯示"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面にシフトを表示"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Schicht auf dem Sperrbildschirm"
          }
        }
      }
    },
    "实时活动已关闭，请在系统设置中打开。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时活动已关闭，请在系统设置中打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activities are disabled. Enable them in Settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時動態已關閉，請在系統設定中開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブアクティビティがオフです。「設定」でオンにしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivitäten sind deaktiviert. Aktiviere sie in den Einstellungen."
          }
        }
      }
    },
    "去设置打开": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去设置打开"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往設定開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開く"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen öffnen"
          }
        }
      }
    },
    "没有可显示的工作班次，请先设置排班。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可显示的工作班次，请先设置排班。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No upcoming work shift. Set up your schedule first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可顯示的工作班次，請先設定班表。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この先の勤務がありません。先にシフトを設定してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine anstehende Schicht. Richte zuerst deinen Dienstplan ein."
          }
        }
      }
    },
    "在锁屏和灵动岛显示下一个班的倒计时，上班中显示离下班还有多久。每次打开班历会刷新一次，系统最多显示约 8 小时；想一直显示，请添加锁屏小组件。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁屏和灵动岛显示下一个班的倒计时，上班中显示离下班还有多久。每次打开班历会刷新一次，系统最多显示约 8 小时；想一直显示，请添加锁屏小组件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a countdown to your next shift on the Lock Screen and Dynamic Island, or time left while you're working. It refreshes when you open ShiftCal and iOS shows it for up to about 8 hours; add a Lock Screen widget to keep it there all the time."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鎖定畫面和動態島顯示下一個班的倒數，上班中顯示離下班還有多久。每次開啟班曆會更新一次，系統最多顯示約 8 小時；想一直顯示，請加入鎖定畫面小工具。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の勤務までのカウントダウン、勤務中は残り時間をロック画面とDynamic Islandに表示します。ShiftCalを開くと更新され、iOSでは最長約8時間表示されます。常に表示したい場合はロック画面ウィジェットを追加してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt auf dem Sperrbildschirm und in der Dynamic Island einen Countdown bis zur nächsten Schicht oder die Restzeit während der Arbeit. Aktualisiert beim Öffnen von ShiftCal; iOS zeigt ihn bis zu etwa 8 Stunden. Für dauerhafte Anzeige ein Sperrbildschirm-Widget hinzufügen."
          }
        }
      }
    },
    "普通通知在静音或专注模式下可能没有声音；闹钟静音也会响，可以稍后再响（9 分钟）。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通通知在静音或专注模式下可能没有声音；闹钟静音也会响，可以稍后再响（9 分钟）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications may be silent in Silent or Focus mode. Alarms ring even on silent and can snooze for 9 minutes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一般通知在靜音或專注模式下可能沒有聲音；鬧鐘靜音也會響，可稍後再響（9 分鐘）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消音モードや集中モードでは通知が鳴らない場合があります。アラームはマナーモードでも鳴り、9分間スヌーズできます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen können im Stumm- oder Fokusmodus lautlos sein. Wecker klingeln auch im Stummmodus und lassen sich 9 Minuten schlummern."
          }
        }
      }
    },
    "提醒会提前排好几周，每次打开班历自动往后续排。两三周没打开过的话，打开一下就行。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒会提前排好几周，每次打开班历自动往后续排。两三周没打开过的话，打开一下就行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders are scheduled a few weeks ahead and extended every time you open ShiftCal. If you haven't opened it in two or three weeks, just open it once."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒會提前排好幾週，每次開啟班曆自動往後續排。兩三週沒開過的話，開一下就好。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は数週間先まで予約され、ShiftCalを開くたびに延長されます。2〜3週間開いていない場合は、一度開いてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen werden einige Wochen im Voraus geplant und bei jedem Öffnen von ShiftCal verlängert. Hast du die App zwei, drei Wochen nicht geöffnet, öffne sie einfach einmal."
          }
        }
      }
    },
    "这个班的闹钟": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个班的闹钟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms for this shift"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個班的鬧鐘"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この勤務のアラーム"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker für diese Schicht"
          }
        }
      }
    },
    "当天或前一天，均以这个班的开始日期为准。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当天或前一天，均以这个班的开始日期为准。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same day and previous day refer to the date this shift starts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當天或前一天，均以這個班的開始日期為準。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「当日」「前日」は、この勤務が始まる日を基準にしています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleicher Tag und Vortag beziehen sich auf den Tag, an dem die Schicht beginnt."
          }
        }
      }
    },
