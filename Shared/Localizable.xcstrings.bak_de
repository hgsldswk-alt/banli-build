    },
    "上班提醒、班次闹钟和锁屏实时显示属于高级版。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上班提醒、班次闹钟和锁屏实时显示属于高级版。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift reminders, alarms and Live Activities are included in Pro."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上班提醒、班次鬧鐘和鎖定畫面即時顯示屬於進階版。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフト通知、アラーム、ライブアクティビティはProに含まれます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schichterinnerungen, Wecker und Live-Aktivitäten sind in Pro enthalten."
          }
        }
      }
    },
    "部分闹钟未能排入系统，已保留最近的闹钟。请减少闹钟数量后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分闹钟未能排入系统，已保留最近的闹钟。请减少闹钟数量后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some alarms could not be scheduled. The nearest scheduled alarms have been kept. Reduce the number of alarms and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分鬧鐘未能排入系統，已保留最近的鬧鐘。請減少鬧鐘數量後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のアラームを設定できませんでした。直近のアラームは残してあります。アラームの数を減らしてもう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Wecker konnten nicht geplant werden. Die nächstgelegenen wurden behalten. Reduziere die Anzahl und versuche es erneut."
          }
        }
      }
    },
    "部分通知未能保存，请重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分通知未能保存，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
