          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分通知未能儲存，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の通知を保存できませんでした。もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Mitteilungen konnten nicht gespeichert werden. Bitte versuche es erneut."
          }
        }
