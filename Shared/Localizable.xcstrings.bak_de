        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブアクティビティを開始できませんでした。アプリに戻ってもう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Aktivität konnte nicht starten. Geh zurück in die App und versuche es erneut."
          }
