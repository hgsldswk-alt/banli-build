          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "響鈴方式與其他提醒"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サウンドとその他の通知"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton & weitere Erinnerungen"
          }
        }
      }
    },
    "这个时间晚于上班时间，不会响。请提前，或改成「前一天」。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个时间晚于上班时间，不会响。请提前，或改成「前一天」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is after your shift starts, so it won't ring. Pick an earlier time or Day before."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個時間晚於上班時間，不會響。請提前，或改成「前一天」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勤務開始より後のため鳴りません。もっと早い時刻か「前日」を選んでください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das liegt nach deinem Schichtbeginn und klingelt nicht. Wähle eine frühere Zeit oder Vortag."
          }
        }
      }
    },
    "按班次设闹钟": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按班次设闹钟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms for each shift"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依班次設鬧鐘"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勤務ごとのアラーム"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker für jede Schicht"
          }
        }
      }
    },
    "早班、夜班各设各的闹钟，调班后自动跟着变，休息日不吵你": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "早班、夜班各设各的闹钟，调班后自动跟着变，休息日不吵你"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate alarms for early and night shifts. They follow your swaps and stay quiet on days off."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "早班、夜班各設各的鬧鐘，調班後自動跟著變，休息日不吵你"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早番と夜勤で別々のアラーム。シフト交代に追従し、休みの日は鳴りません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Wecker für Früh- und Nachtschicht. Sie folgen deinen Tauschen und bleiben an freien Tagen still."
          }
        }
      }
    },
    "睡前告诉你明天上什么班、几点上，不用再翻排班表": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前告诉你明天上什么班、几点上，不用再翻排班表"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know tomorrow's shift and start time before bed. No more checking the roster."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前告訴你明天上什麼班、幾點上，不用再翻班表"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "寝る前に明日の勤務と開始時刻がわかります。もうシフト表を確認しに行く必要はありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenne die Schicht und Startzeit von morgen schon vor dem Schlafen. Kein Blick mehr auf den Dienstplan."
          }
        }
      }
