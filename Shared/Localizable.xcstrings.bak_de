    "1. 在桌面空白处长按，直到图标开始晃动": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 在桌面空白处长按，直到图标开始晃动"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Touch and hold an empty area of your Home Screen until the icons jiggle."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 長按主畫面空白處，直到圖示開始晃動"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. ホーム画面の何もない所を、アイコンが揺れるまで長押しします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Halte eine leere Stelle auf dem Home-Bildschirm gedrückt, bis die Symbole wackeln."
          }
        }
      }
    },
    "1. 在锁屏长按，点「自定」→「锁定屏幕」": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 在锁屏长按，点「自定」→「锁定屏幕」"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Touch and hold the Lock Screen, then tap Customize → Lock Screen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 長按鎖定畫面，點「自訂」→「鎖定畫面」"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. ロック画面を長押しし、「カスタマイズ」→「ロック画面」をタップします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Halte den Sperrbildschirm gedrückt und tippe auf Anpassen → Sperrbildschirm."
          }
        }
      }
    },
    "12 小时班，4 天一循环": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "12 小时班，4 天一循环"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "12-hour shifts, 4-day cycle"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "12 小時班，4 天一循環"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12時間勤務・4日周期"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "12-Stunden-Schichten, 4-Tage-Zyklus"
          }
        }
      }
    },
    "2. 点左上角「编辑」→「添加小组件」": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 点左上角「编辑」→「添加小组件」"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Tap Edit at the top left, then Add Widget."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 點左上角「編輯」→「加入小工具」"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 左上の「編集」→「ウィジェットを追加」をタップします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Tippe oben links auf Bearbeiten und dann auf Widget hinzufügen."
          }
        }
      }
    },
    "2. 点时间下方的小组件区域": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 点时间下方的小组件区域"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Tap the widget area below the time."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 點時間下方的小工具區域"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 時刻の下のウィジェット欄をタップします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Tippe auf den Widget-Bereich unter der Uhrzeit."
          }
        }
      }
    },
    "3. 搜索「班历」，选大小后点「添加小组件」": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 搜索「班历」，选大小后点「添加小组件」"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Search for ShiftCal, choose a size, then tap Add Widget."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 搜尋「班曆」，選擇尺寸後點「加入小工具」"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 「ShiftCal」を検索してサイズを選び、「ウィジェットを追加」をタップします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Suche nach ShiftCal, wähle eine Größe und tippe auf Widget hinzufügen."
          }
        }
      }
    },
    "3. 选「班历」": {
      "extractionState": "manual",
