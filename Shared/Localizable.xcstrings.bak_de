    "%@时只有 %lld°C，多穿一件": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@时只有 %lld°C，多穿一件"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only %2$lld°C when you %1$@. Bring an extra layer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@時只有 %2$lld°C，記得多穿一件"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ときは%2$lld°Cまで下がります。羽織るものを一枚どうぞ。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur %2$lld °C, wenn du %1$@. Nimm eine Schicht mehr mit."
          }
        }
      }
    },
    "%@时（%@）可能下雨，记得带伞": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@时（%@）可能下雨，记得带伞"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rain is possible when you %1$@ (%2$@). Bring an umbrella."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@時（%2$@）可能下雨，記得帶傘"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@とき（%2$@）は雨の可能性があります。傘をお忘れなく。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regen ist möglich, wenn du %1$@ (%2$@). Nimm einen Schirm mit."
          }
        }
      }
    },
    "%@路上 %lld°C，注意防暑多喝水": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@路上 %lld°C，注意防暑多喝水"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld°C when you %1$@. Stay cool and drink water."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@途中 %2$lld°C，注意防曬、多補充水分"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ときは%2$lld°Cです。涼しくして水分をとりましょう。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld °C, wenn du %1$@. Bleib kühl und trink genug."
          }
        }
      }
    },
